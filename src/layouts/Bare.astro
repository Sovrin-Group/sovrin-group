---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sovrin Group - Unified Architecture. Governed Identity. Deterministic Systems.',
} = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script>
      // Reveal the logo only after everything else has finished loading, so the
      // fade is actually seen rather than happening during page render.
      (function () {
        var started = false;
        function reveal() {
          if (started) return;
          started = true;
          document
            .querySelectorAll('.cs-mark, .hero-home .mark')
            .forEach(function (el) { el.classList.add('reveal-in'); });
        }
        // a short beat after load so the fade reads as its own moment
        if (document.readyState === 'complete') {
          setTimeout(reveal, 250);
        } else {
          window.addEventListener('load', function () { setTimeout(reveal, 250); });
        }
        // safety net: never leave the logo invisible if load never fires
        setTimeout(reveal, 5000);
      })();
    </script>
  </body>
</html>
