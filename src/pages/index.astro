---
import Base from '../layouts/Base.astro';
---
<Base title="Sovrin Group — Unified Architecture. Governed Identity. Deterministic Systems." section="home">
  <section class="hero-home">
    <div class="container">
      <img class="mark" src="/images/logo.png" alt="" />
      <h1>Unified Architecture.<br />Governed Identity.<br />Deterministic Systems.</h1>
      <p class="lede">
        AI systems should be built on identity, governed with clarity, and designed
        to stay aligned as they grow.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <a class="card" href="/solutions/identity/">
          <div class="card-icon"><img src="/images/glyph-nabla-s.png" alt="" /></div>
          <h3>Governed Identity</h3>
          <p>Non-negotiable adherence to identity governance.</p>
        </a>
        <a class="card" href="/solutions/">
          <div class="card-icon"><img src="/images/glyph-contour-s.png" alt="" /></div>
          <h3>Unified Architecture</h3>
          <p>Unified architecture for digital sovereignty.</p>
        </a>
        <a class="card" href="/resources/">
          <div class="card-icon"><img src="/images/glyph-integral-i.png" alt="" /></div>
          <h3>Deterministic Systems</h3>
          <p>Deterministic integrity and auditability.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="band-dark">
        <div>
          <h2>Common dots. Uncommon insights.</h2>
          <p>
            Explore Sovrin Group's white papers on identity, governance, and AI
            alignment — formal publications outlining our architectural principles
            and invariants.
          </p>
        </div>
        <a class="btn btn-light" href="/resources/whitepapers/">Browse White Papers</a>
      </div>
    </div>
  </section>
</Base>
