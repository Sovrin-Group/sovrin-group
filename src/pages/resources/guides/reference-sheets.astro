---
import Base from '../../../layouts/Base.astro';
---
<Base title="Reference Sheets | Sovrin Group" section="resources">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">Guides &amp; Reference · Reference Sheets</p>
      <h1>Reference Sheets</h1>
      <p class="lede">
        Lightweight summaries that outline core structures, relationships, and
        terminology.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p><span class="badge">Coming Soon</span></p>
      <p>
        This material is in development. It will be published here once it is
        released.
      </p>
      <p style="margin-top: 2rem;">
        <a class="btn btn-ghost" href="/resources/guides/">Back to Guides &amp; Reference</a>
      </p>
    </div>
  </section>
  </div>
</Base>
