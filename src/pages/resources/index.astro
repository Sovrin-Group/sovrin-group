---
import Base from '../../layouts/Base.astro';
---
<Base title="Resources — Sovrin Group" section="resources">
  <section class="hero-page dark-zone">
    <div class="container">
      <p class="kicker">Resources</p>
      <h1>Common dots. Uncommon Insights.</h1>
      <p class="lede">
        Perspectives, frameworks, and references on identity, governance, and AI
        alignment.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <a class="card" href="/resources/whitepapers/">
          <div class="card-icon"><img src="/images/glyph-therefore-s.png" alt="" /></div>
          <h3>Insights &amp; Whitepapers</h3>
          <p>Perspectives on identity, governance, and AI alignment.</p>
        </a>
        <a class="card" href="/resources/frameworks/">
          <div class="card-icon"><img src="/images/glyph-turnstile-i.png" alt="" /></div>
          <h3>Frameworks &amp; Models</h3>
          <p>High-level structures that illustrate how Sovrin systems hold their shape.</p>
        </a>
        <a class="card" href="/resources/guides/">
          <div class="card-icon"><img src="/images/glyph-emptyset-s.png" alt="" /></div>
          <h3>Guides &amp; References</h3>
          <p>Clear, accessible explanations of core concepts and terminology.</p>
        </a>
      </div>
    </div>
  </section>
</Base>
