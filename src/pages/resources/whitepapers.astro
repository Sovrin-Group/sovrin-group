---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('whitepapers');

// Newest first within each category
papers.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Preferred category display order; anything new lands at the end automatically.
const categoryOrder = [
  'Unified Architecture',
  'Governed Identity',
  'Identity Theory',
  'Case Studies',
  'Other Research',
];

const categories = [...new Set(papers.map((p) => p.data.category))].sort((a, b) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="White Papers — Sovrin Group" section="resources">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">Resources · Insights &amp; Whitepapers</p>
      <h1>White Papers</h1>
      <p class="lede">
        Formal publications outlining Sovrin Group's architectural principles and
        invariants. Every Sovrin architecture inherits from the same foundation:
        identity as operator, governance as architecture, and continuity as law.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {papers.length === 0 && (
        <div class="wp-empty">
          <p>New publications are on the way. Check back soon.</p>
        </div>
      )}

      {categories.map((cat) => (
        <div class="wp-category">
          <h2>{cat}</h2>
          <div class="wp-grid">
            {papers
              .filter((p) => p.data.category === cat)
              .map((p) => (
                <article class="wp-card">
                  <span class="wp-date">{fmt(p.data.date)}</span>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <a class="btn" href={p.data.pdf} target="_blank" rel="noopener">
                    Download PDF
                  </a>
                </article>
              ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
