---
import Base from '../../layouts/Base.astro';
---
<Base title="Solutions — Sovrin Group" section="solutions">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">Solutions</p>
      <h1>Unified Architecture. Global Identity.</h1>
      <p class="lede">
        Sovrin Group applies its unified architecture across three core domains.
        These are the surfaces where the identity invariant becomes operational.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <a class="card" href="/solutions/identity/">
          <span class="badge badge-ghost" aria-hidden="true">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-lambda-i.png" alt="" /></div>
          <h3>Identity Governance Architecture</h3>
          <p>Deterministic identity structures that anchor system truth.</p>
        </a>
        <div class="card">
          <span class="badge">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-nabla-s.png" alt="" /></div>
          <h3>AI Governance Frameworks</h3>
          <p>Audit-grade continuity and governed AI behavior.</p>
        </div>
        <div class="card">
          <span class="badge">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-box-s.png" alt="" /></div>
          <h3>Data Classification &amp; Retention</h3>
          <p>Compliance-driven lifecycle models built on identity and traceability.</p>
        </div>
      </div>

      <p class="section-lede" style="margin-top: 2.4rem; margin-bottom: 0;">
        All Sovrin solutions inherit from the same invariant: <strong>identity as
        operator, governance as architecture</strong>, and systems that hold
        their shape.
      </p>
    </div>
  </section>
  </div>
</Base>
