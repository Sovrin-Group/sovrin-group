---
import Base from '../../layouts/Base.astro';
---
<Base title="Unified Identity | Sovrin Group" section="solutions">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">Solutions · Unified Identity</p>
      <h1>Unified Identity<sup class="tm">™</sup></h1>
      <p class="lede">Everything begins with identity.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>
        Organizations rely on people, systems, applications, devices, and services working together. Unified Identity creates a trusted foundation by establishing a clear understanding of who and what exists, who is responsible, and how trust is maintained across the enterprise.
      </p>
      <h2>Ready to strengthen trust through identity?</h2>
      <p>Explore the services designed to help organizations establish accountability, visibility, and confidence.</p>
      <div class="page-links" style="margin-top: 2rem;">
        <a class="btn" href="/solutions/systems/">Deterministic Systems</a>
        <a class="btn" href="/solutions/continuity/">Governed Continuity</a>
      </div>
      <p style="margin-top: 0.9rem;">
        <a class="btn btn-ghost" href="/solutions/">Back to Solutions</a>
      </p>
    </div>
  </section>
  </div>
</Base>
