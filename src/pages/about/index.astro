---
import Base from '../../layouts/Base.astro';
---
<Base title="About — Sovrin Group" section="about">
  <section class="hero-page dark-zone">
    <div class="container">
      <p class="kicker">About</p>
      <h1>Architected Governance. Sovrin Identity.</h1>
      <p class="lede">
        Founded on principles of governance and digital sovereignty, guided by
        experienced and trusted leadership.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <a class="card" href="/about/origins/">
          <h3>Origins</h3>
          <p>Founded on principles of governance and digital sovereignty.</p>
        </a>
        <div class="card">
          <span class="badge">Coming Soon</span>
          <h3>Governance Framework</h3>
          <p>SIG Governance Structure — deterministic, governed system design.</p>
        </div>
        <div class="card">
          <span class="badge">Coming Soon</span>
          <h3>Architecture Team</h3>
          <p>Guided by experienced and trusted leadership.</p>
        </div>
        <a class="card" href="/about/principles/">
          <h3>Principles</h3>
          <p>Trust. Transparency. Fairness. Authenticity.</p>
        </a>
      </div>
    </div>
  </section>
</Base>
