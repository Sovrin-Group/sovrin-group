---
import Base from '../../layouts/Base.astro';
---
<Base title="About | Sovrin Group" section="about">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">About</p>
      <h1>Architected Governance. Sovrin Identity.</h1>
      <p class="lede">
        Founded on principles of governance and digital sovereignty, guided by
        experienced and trusted leadership.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <a class="card" href="/about/origins/">
          <span class="badge badge-ghost" aria-hidden="true">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-about-origins.png" alt="" /></div>
          <h2>Origins</h2>
          <p>Founded on principles of governance and digital sovereignty.</p>
        </a>
        <a class="card" href="/about/principles/">
          <span class="badge badge-ghost" aria-hidden="true">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-about-principles.png" alt="" /></div>
          <h2>Principles</h2>
          <p>The governing laws that shape every Sovrin system.</p>
        </a>
        <a class="card" href="/about/team/">
          <span class="badge badge-ghost" aria-hidden="true">Coming Soon</span>
          <div class="card-icon"><img src="/images/glyph-about-team.png" alt="" /></div>
          <h2>Architecture Team</h2>
          <p>Guided by experienced and trusted leadership.</p>
        </a>
      </div>
    </div>
  </section>
  </div>
</Base>
