---
import Base from '../../layouts/Base.astro';

// Text is the client's own, copied exactly as she supplied it (October 2026),
// including her punctuation, em dashes and non-breaking hyphens.
const principles = [
  {
    num: '1',
    title: `Identity Is the Anchor of Every System`,
    body: `Identity is the invariant every governed system must inherit from. It establishes continuity across people, processes, data, and intelligent systems. When identity fractures, systems drift, governance collapses, and risk compounds.`,
    governs: [
      `identity continuity`,
      `credentialing and trust frameworks`,
      `cross‑domain identity integration`,
      `substrate‑layer inheritance rules`,
    ],
    close: `Identity is the upstream operator. Everything else is downstream.`,
  },
  {
    num: '2',
    title: `Governance Works Only When It's Architectural, Not After‑the‑Fact`,
    body: `Governance is a design property, not an enforcement activity. Systems behave correctly when governance is embedded into the substrate. When governance is bolted on, systems drift, fracture, and fail under load.`,
    governs: [
      `governed reasoning substrates`,
      `deterministic system behavior`,
      `audit‑grade reconstruction and custody`,
      `continuity and non‑fracture frameworks`,
    ],
    close: `Governance must be structural, proactive, and unavoidable.`,
  },
  {
    num: '3',
    title: `Trust is the apex objective.`,
    body: `Trust is a human outcome, not a technical feature. People trust systems when those systems behave consistently, transparently, and without drift. Trust emerges when the architecture makes correctness the default and eliminates the need for belief, persuasion, or reassurance.`,
    governs: [
      `trust compliance (T=1)`,
      `transparent constraint surfaces`,
      `human‑interpretable reasoning`,
      `verifiable continuity and custody`,
    ],
    close: `Trust must be architected, not requested.`,
  },
  {
    num: '4',
    title: `Complexity Is the Enemy of Continuity`,
    body: `Complexity creates drift, brittleness, and emergent failure modes. Clear architectures, clear identity models, and clear governance rules produce predictable, reconstructable systems. Clarity is not aesthetic — it is operational safety.`,
    governs: [
      `architecture simplification`,
      `continuity surfaces`,
      `metadata governance`,
      `classification frameworks`,
    ],
    close: `Clarity is a security control.`,
  },
  {
    num: '5',
    title: `People and AI Build Better Systems Together Than Either Can Alone`,
    body: `AI amplifies human capability; humans anchor AI to meaning, context, and accountability. The strongest systems are co‑designed: human‑defined, AI‑executed, and substrate‑governed. This prevents drift, preserves intent, and ensures deterministic behavior.`,
    governs: [
      `human‑defined governance states`,
      `deterministic AI execution`,
      `substrate‑layer alignment`,
      `non‑drifting operational behavior`,
    ],
    close: `AI does not replace humans. AI extends governed human capability.`,
  },
  {
    num: '6',
    title: `Good Systems Stay Aligned as They Grow`,
    body: `Scale must never break alignment. Systems must maintain continuity across identity, data, and operational substrates — even as they expand. Alignment is a structural requirement, not a feature.`,
    governs: [
      `substrate‑layer architecture`,
      `cross‑system integration`,
      `retention governance`,
      `chain‑of‑custody and lineage`,
    ],
    close: `Growth must preserve continuity, not erode it.`,
  },
];
---
<Base title="Principles | Sovrin Group" section="about">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">About · Principles</p>
      <h1>The Principles That Govern Sovrin's Architecture.</h1>
      <p class="lede">
        Sovrin Group operates on a set of architectural principles that define how identity, governance, continuity, and AI must behave to remain safe, aligned, and non-drifting. These principles are not values, aspirations, or recommendations. They are structural laws that every Sovrin system, model, and governance framework must inherit.
      </p>
      <p class="lede">
        They establish continuity. They eliminate drift. They create systems that behave correctly by design.
      </p>
    </div>
  </section>

  <section class="section section-cards">
    <div class="container">
      <div class="prose principle-intro">
        <h2>How Principles Shape the Architecture</h2>
        <p>
          At Sovrin, architecture follows principle. These principles are not guidance layered onto systems after they are designed. They are the source from which the architecture is derived.
        </p>
        <p>
          Every Sovrin system inherits its identity model, governance model, continuity requirements, human stewardship controls, and trust objectives directly from these principles. Together, they define how Sovrin designs systems that remain governed, aligned, explainable, and trustworthy as they evolve.
        </p>
      </div>

      <div class="tenet-list">
        {principles.map((p) => (
          <article class="tenet principle">
            <div class="principle-num" aria-hidden="true">{p.num}</div>
            <div class="principle-body">
              <h2><span class="sr-only">{p.num}. </span>{p.title}</h2>
              <p>{p.body}</p>
              <p class="principle-governs">This principle governs:</p>
              <ul>
                {p.governs.map((g) => <li>{g}</li>)}
              </ul>
              <p class="principle-close">{p.close}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="prose principle-closing">
        <div class="page-links" style="margin-top: 0;">
          <a class="btn" href="/about/origins/">Origins</a>
          <a class="btn" href="/about/team/">Architecture Team</a>
        </div>
        <p style="margin-top: 2rem;">
          <a class="btn btn-ghost" href="/about/">Back to About</a>
        </p>
      </div>
    </div>
  </section>
  </div>
</Base>
