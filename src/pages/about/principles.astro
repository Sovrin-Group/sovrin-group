---
import Base from '../../layouts/Base.astro';

// Text is the client's own, copied exactly as she supplied it (September 2026),
// including her punctuation and her non-breaking hyphens.
const principles = [
  {
    title: '1. Identity Is the Anchor of Every System',
    body: 'Identity is the invariant that every governed system must inherit from. It establishes continuity across people, processes, data, and AI substrates. When identity is fractured, systems drift, governance collapses, and risk compounds.',
    governs: [
      'identity continuity',
      'credentialing and trust frameworks',
      'cross‑domain identity integration',
      'substrate‑layer inheritance rules',
    ],
    close: 'Identity is the upstream operator. Everything else is downstream.',
  },
  {
    title: "2. Governance Works Best When It's Designed, Not Enforced",
    body: 'Governance is an architectural function — not a policing function. When governance is embedded into the substrate, systems behave correctly by default. When governance is bolted on, systems fracture, drift, and fail under load.',
    governs: [
      'governed reasoning models',
      'deterministic system design',
      'audit‑grade controls',
      'continuity frameworks',
    ],
    close: 'Governance must be structural, not reactive.',
  },
  {
    title: '3. People and AI Build Better Systems Together Than Either Can Alone',
    body: 'AI amplifies human capability; humans anchor AI to meaning, context, and accountability. The strongest systems are co‑designed: human‑defined, AI‑executed, and substrate‑governed.',
    governs: [
      'human‑defined governance states',
      'deterministic AI execution',
      'substrate‑layer alignment',
      'non‑drifting operational behavior',
    ],
    close: 'AI does not replace humans. AI extends governed human capability.',
  },
  {
    title: '4. Clarity Creates Trust; Complexity Creates Risk',
    body: 'Complexity is the enemy of continuity. Clear architectures, clear identity models, and clear governance rules produce predictable systems. Ambiguity produces drift, brittleness, and emergent failure modes.',
    governs: [
      'architecture simplification',
      'continuity surfaces',
      'metadata governance',
      'classification frameworks',
    ],
    close: 'Clarity is a security control.',
  },
  {
    title: '5. Good Systems Stay Aligned as They Grow',
    body: 'Scale should never break alignment. Systems must maintain continuity across identity, data, and operational substrates — even as they expand. Alignment is not a feature; it is a structural requirement.',
    governs: [
      'substrate‑layer architecture',
      'cross‑system integration',
      'retention governance',
      'chain‑of‑custody and lineage',
    ],
    close: 'Growth must preserve continuity, not erode it.',
  },
];
---
<Base title="Principles | Sovrin Group" section="about">
  <div class="dark-zone page-dark">
  <section class="hero-page hero-flush">
    <div class="container">
      <p class="kicker">About · Principles</p>
      <h1>The governing laws that shape every Sovrin system.</h1>
      <p class="lede">
        Sovrin Group operates on a set of architectural principles that define how identity, governance, and AI must behave to remain safe, aligned, and continuous. These principles are not values or aspirations — they are structural laws that every Sovrin artifact, model, and substrate‑layer design must inherit from.
      </p>
      <p class="lede">
        They ensure continuity. They eliminate drift. They create systems that behave correctly by design.
      </p>
    </div>
  </section>

  <section class="section section-flush">
    <div class="container">
      <div class="tenet-list">
        {principles.map((p) => (
          <article class="tenet principle">
            <div class="principle-body">
              <h2>{p.title}</h2>
              <p>{p.body}</p>
              <p class="principle-governs">This principle governs:</p>
              <ul>
                {p.governs.map((g) => <li>{g}</li>)}
              </ul>
              <p class="principle-close">{p.close}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="prose principle-closing">
        <h2>How Principles Shape the Architecture</h2>
        <p>
          These principles define how Sovrin designs governed systems. Identity anchors the architecture. Architecture creates continuity. Continuity enables safe, deterministic AI. Deterministic AI enables accountable operations.
        </p>
        <p class="doctrine">This is the Sovrin doctrine: Identity → Architecture → Continuity → Deterministic AI → Governed Systems</p>

        <h2>Governance Declaration</h2>
        <p>
          These principles govern every Sovrin artifact, every model, every substrate‑layer design, and every continuity framework. They are the foundation of SIG‑Eighty kiln‑mode and the governed reasoning models that support it.
        </p>

        <p style="margin-top: 2rem;">
          <a class="btn btn-ghost" href="/about/">Back to About</a>
        </p>
      </div>
    </div>
  </section>
  </div>
</Base>

<style>
  /* the version Randy saw and approved: 3rem under the intro, none above the cards */
  .hero-flush { padding-bottom: 3rem; }
  .section-flush { padding-top: 0; }
</style>
