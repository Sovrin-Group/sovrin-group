---
import Base from '../../layouts/Base.astro';
---
<Base title="Architecture Team | Sovrin Group" section="about">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">About · Architecture Team</p>
      <h1>Guided by experienced and trusted leadership.</h1>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>
        Sovrin Group's architecture is shaped by a <strong>human + AI
        co-architecture approach</strong>, where people and AI build better
        systems together than either can alone.
      </p>
      <p>
        The team works across disciplines rather than within a single one,
        integrating governance, compliance, security, and enterprise
        architecture into a single coherent structure.
      </p>
      <h2>Cross-disciplinary integration</h2>
      <ul>
        <li>Governance</li>
        <li>Compliance</li>
        <li>Security</li>
        <li>Enterprise architecture</li>
      </ul>
      <p style="margin-top: 2rem;">
        <a class="btn btn-ghost" href="/about/">Back to About</a>
      </p>
    </div>
  </section>
  </div>
</Base>
