---
import Base from '../../layouts/Base.astro';
---
<Base title="Architecture Team | Sovrin Group" section="about">
  <div class="dark-zone page-dark">
  <section class="hero-page">
    <div class="container">
      <p class="kicker">About · Architecture Team</p>
      <h1>Guided by experienced and trusted leadership.</h1>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>
        Sovrin's architecture team designs governed systems that preserve identity, maintain alignment, and sustain trust over time. We create architectures that remain stable, explainable, and accountable as organizations evolve.
      </p>
      <p>
        We design systems where human intent is preserved, governance is architectural rather than reactive, and AI operates within clearly defined boundaries. Our focus is long-term continuity, ensuring that identity, context, accountability, and trust remain intact as systems grow and change.
      </p>
      <h2>Our architectural posture:</h2>
      <ul>
        <li>trust as the apex objective</li>
        <li>identity first, always</li>
        <li>governance as a structural property, not an add-on</li>
        <li>human stewardship as a permanent requirement</li>
        <li>continuity without drift</li>
      </ul>
      <div class="page-links" style="margin-top: 2rem;">
        <a class="btn" href="/about/origins/">Origins</a>
        <a class="btn" href="/about/principles/">Principles</a>
      </div>
      <p style="margin-top: 2rem;">
        <a class="btn btn-ghost" href="/about/">Back to About</a>
      </p>
    </div>
  </section>
  </div>
</Base>

