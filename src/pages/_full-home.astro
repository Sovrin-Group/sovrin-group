---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('whitepapers');
papers.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = papers.slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Sovrin Group — Unified Architecture. Governed Identity. Deterministic Systems." section="home">
  <div class="dark-zone">
    <section class="hero-home">
      <div class="container split">
        <div>
          <p class="kicker">Sovrin Group</p>
          <h1>
            <span>Unified Architecture.</span>
            <span>Governed Identity.</span>
            <span>Deterministic Systems.</span>
          </h1>
          <p class="lede">
            AI systems should be built on identity, governed with clarity, and
            designed to stay aligned as they grow.
          </p>
          <div class="actions">
            <a class="btn" href="/solutions/">Explore Solutions</a>
            <a class="btn btn-ghost" href="/resources/whitepapers/">Browse White Papers</a>
          </div>
        </div>
        <div class="mark-wrap">
          <img class="mark" src="/images/logo-ray-current.png" alt="Sovrin Group mark" />
        </div>
      </div>
    </section>

    <section class="pillars">
      <div class="container">
        <div class="pillar-grid">
          <a class="pillar" href="/solutions/identity/">
            <img class="glyph" src="/images/glyph-arrow-fg.png" alt="" />
            <h3>Governed Identity</h3>
            <p>Non-negotiable adherence to identity governance.</p>
          </a>
          <a class="pillar" href="/solutions/">
            <img class="glyph" src="/images/glyph-mp-i.png" alt="" />
            <h3>Unified Architecture</h3>
            <p>Unified architecture for digital sovereignty.</p>
          </a>
          <a class="pillar" href="/resources/">
            <img class="glyph" src="/images/glyph-contour-s.png" alt="" />
            <h3>Deterministic Systems</h3>
            <p>Deterministic integrity and auditability.</p>
          </a>
        </div>
      </div>
    </section>

  {latest.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="kicker">Latest Research</p>
          <h2 class="section-title">Common dots. Uncommon insights.</h2>
          <p class="section-lede">
            Recent publications on identity, governance, and AI alignment.
          </p>
        </div>
        <div class="wp-grid">
          {latest.map((p) => (
            <article class="wp-card">
              <span class="wp-date">{fmt(p.data.date)}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <a class="btn" href={p.data.pdf} target="_blank" rel="noopener">Download PDF</a>
            </article>
          ))}
        </div>
        <p style="margin-top: 1.8rem;">
          <a class="btn btn-ghost" href="/resources/whitepapers/">
            View All White Papers
          </a>
        </p>
      </div>
    </section>
  )}
  </div>
</Base>
